<?xml version="1.0" encoding="UTF-8"?>
<!--
  AI Account Guard for Google Chrome and Microsoft Edge on macOS.
  Upload in Jamf Pro: Computers > Configuration Profiles > New > Upload.
  Edit the policy values below (in both browsers' payloads) before uploading, or make a
  filled-in copy at https://stratitsolutions.com/ai-account-guard/setup/
  Replace the PayloadUUIDs with fresh values (run `uuidgen`) if you make copies.
  Remove the two Edge payloads if you don't use Edge.
  IncognitoModeAvailability / InPrivateModeAvailability = 1 and BrowserGuestModeEnabled = false
  turn off private and guest windows, where extensions don't run; delete them to leave those on.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadDisplayName</key>
  <string>AI Account Guard</string>
  <key>PayloadIdentifier</key>
  <string>org.example.aiaccountguard</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadUUID</key>
  <string>6E5C3B0A-8F7D-4E43-9C1B-2A4B5C6D7E80</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadContent</key>
  <array>
    <!-- Force-install the extension -->
    <dict>
      <key>PayloadType</key>
      <string>com.google.Chrome</string>
      <key>PayloadIdentifier</key>
      <string>org.example.aiaccountguard.install</string>
      <key>PayloadUUID</key>
      <string>1B2C3D4E-5F60-4718-8A9B-0C1D2E3F4A51</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>ExtensionInstallForcelist</key>
      <array>
        <string>jhhgomolhbopcedgcnilbggglnfikmfd;https://clients2.google.com/service/update2/crx</string>
      </array>
      <key>IncognitoModeAvailability</key>
      <integer>1</integer>
      <key>BrowserGuestModeEnabled</key>
      <false/>
    </dict>
    <!-- Extension policy (read by the extension via chrome.storage.managed) -->
    <dict>
      <key>PayloadType</key>
      <string>com.google.Chrome.extensions.jhhgomolhbopcedgcnilbggglnfikmfd</string>
      <key>PayloadIdentifier</key>
      <string>org.example.aiaccountguard.policy</string>
      <key>PayloadUUID</key>
      <string>2C3D4E5F-6071-4829-9B0C-1D2E3F4A5B62</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>AllowedDomains</key>
      <array>
        <string>example.org</string>
      </array>
      <key>OrganizationName</key>
      <string>Example Org</string>
      <key>OrganizationLogo</key>
      <string></string>
      <key>SsoPortalUrl</key>
      <string>https://myapps.microsoft.com</string>
      <key>SupportMessage</key>
      <string>Questions? Contact IT.</string>
      <key>AllowGoogleSignIn</key>
      <false/>
      <key>AllowMicrosoftSignIn</key>
      <true/>
      <key>MicrosoftTenantId</key>
      <string>00000000-0000-0000-0000-000000000000</string>
      <key>TenantRestrictionScope</key>
      <string>ai-sites</string>
      <key>ProviderModes</key>
      <dict>
        <key>deepseek</key>
        <string>block</string>
      </dict>
      <key>SignOutOnInstall</key>
      <true/>
    </dict>
    <!-- Microsoft Edge: force install from the Chrome Web Store -->
    <dict>
      <key>PayloadType</key>
      <string>com.microsoft.Edge</string>
      <key>PayloadIdentifier</key>
      <string>org.example.aiaccountguard.edge.install</string>
      <key>PayloadUUID</key>
      <string>3D4E5F60-7182-4A3B-8C0D-2E3F4A5B6C73</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>ExtensionInstallForcelist</key>
      <array>
        <string>jhhgomolhbopcedgcnilbggglnfikmfd;https://clients2.google.com/service/update2/crx</string>
      </array>
      <key>InPrivateModeAvailability</key>
      <integer>1</integer>
      <key>BrowserGuestModeEnabled</key>
      <false/>
    </dict>
    <!-- Microsoft Edge: extension policy (same values as Chrome's) -->
    <dict>
      <key>PayloadType</key>
      <string>com.microsoft.Edge.extensions.jhhgomolhbopcedgcnilbggglnfikmfd</string>
      <key>PayloadIdentifier</key>
      <string>org.example.aiaccountguard.edge.policy</string>
      <key>PayloadUUID</key>
      <string>4E5F6071-8293-4B4C-9D1E-3F4A5B6C7D84</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>AllowedDomains</key>
      <array>
        <string>example.org</string>
      </array>
      <key>OrganizationName</key>
      <string>Example Org</string>
      <key>OrganizationLogo</key>
      <string></string>
      <key>SsoPortalUrl</key>
      <string>https://myapps.microsoft.com</string>
      <key>SupportMessage</key>
      <string>Questions? Contact IT.</string>
      <key>AllowGoogleSignIn</key>
      <false/>
      <key>AllowMicrosoftSignIn</key>
      <true/>
      <key>MicrosoftTenantId</key>
      <string>00000000-0000-0000-0000-000000000000</string>
      <key>TenantRestrictionScope</key>
      <string>ai-sites</string>
      <key>ProviderModes</key>
      <dict>
        <key>deepseek</key>
        <string>block</string>
      </dict>
      <key>SignOutOnInstall</key>
      <true/>
    </dict>
  </array>
</dict>
</plist>
