    <presentationTable>
      <presentation id="AllowedDomains">
        <listBox refId="AllowedDomains">Domeinen:</listBox>
      </presentation>
      <presentation id="OrganizationName">
        <textBox refId="OrganizationName">
          <label>Naam van de organisatie:</label>
        </textBox>
      </presentation>
      <presentation id="SsoPortalUrl">
        <textBox refId="SsoPortalUrl">
          <label>Adres van het portaal:</label>
        </textBox>
      </presentation>
      <presentation id="SupportMessage">
        <textBox refId="SupportMessage">
          <label>Bericht:</label>
        </textBox>
      </presentation>
      <presentation id="MicrosoftTenantId">
        <textBox refId="MicrosoftTenantId">
          <label>Tenant-ID:</label>
        </textBox>
      </presentation>
      <presentation id="TenantRestrictionScope">
        <dropdownList refId="TenantRestrictionScope" noSort="true" defaultItem="0">Toepassen op:</dropdownList>
      </presentation>
      <presentation id="ProviderMode">
        <dropdownList refId="ProviderMode" noSort="true" defaultItem="0">Modus:</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
